# Copy to .secrets/dev (and staging, production) and fill in the values. Everything in .secrets/ except this file stays out of git.

# ANTHROPIC_API_KEY: for the chat (POST /chat). Set a spending limit in the Anthropic workspace; the model can be changed with the variable MODEL (default claude-haiku-5-5).
ANTHROPIC_API_KEY=

# GitHub App (client secret from the App's settings page) .
GITHUB_CLIENT_SECRET=

# SESSION_SECRET: any long random string, e.g. `openssl rand -base64 32`. Changing it signs everybody out.
SESSION_SECRET=

# WEBHOOK_SECRET: the secret entered in the GitHub App's webhook settings (any long random string, `openssl rand -hex 32`).
WEBHOOK_SECRET=

# The object store (Hetzner Object Storage, public bucket) for the files of objects. The browser uploads straight to it with signed URLs.
# S3_ENDPOINT and S3_BUCKET are variables of wrangler.toml for staging and production; for local development they go here (the bucket of dev).
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
